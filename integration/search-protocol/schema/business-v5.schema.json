        "diagnostics": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/diagnostic" } },
        "diagnostic_coverage": { "$ref": "#/$defs/referenceDiagnosticCoverage" }
      }
    },
    "suggestResponse": { "type": "object", "additionalProperties": false, "required": ["protocol_revision", "generation", "query_policy_id", "prefix", "took_ms", "suggestions"], "properties": { "protocol_revision": { "$ref": "#/$defs/revision" }, "generation": { "$ref": "#/$defs/generationStamp" }, "query_policy_id": { "$ref": "#/$defs/queryPolicyId" }, "prefix": { "type": "string" }, "took_ms": { "$ref": "#/$defs/uint64" }, "suggestions": { "type": "array", "items": { "type": "string" }, "maxItems": 50 } } },
    "reindexAnalysisEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets_visited", "assets_analyzed", "source_opens", "source_bytes_read", "text_sources", "text_bytes_scanned", "yaml_documents", "binary_objects", "unity_values_visited", "references_emitted", "container_entries_emitted", "truncations_emitted", "diagnostics_emitted"],
      "properties": {
        "assets_visited": { "$ref": "#/$defs/uint64" },
        "assets_analyzed": { "$ref": "#/$defs/uint64" },
        "source_opens": { "$ref": "#/$defs/uint64" },
        "source_bytes_read": { "$ref": "#/$defs/uint64" },
        "text_sources": { "$ref": "#/$defs/uint64" },
        "text_bytes_scanned": { "$ref": "#/$defs/uint64" },
        "yaml_documents": { "$ref": "#/$defs/uint64" },
        "binary_objects": { "$ref": "#/$defs/uint64" },
        "unity_values_visited": { "$ref": "#/$defs/uint64" },
        "references_emitted": { "$ref": "#/$defs/uint64" },
        "container_entries_emitted": { "$ref": "#/$defs/uint64" },
        "truncations_emitted": { "$ref": "#/$defs/uint64" },
        "diagnostics_emitted": { "$ref": "#/$defs/uint64" }
      }
    },
    "reindexDiskEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existing_generation_bytes", "old_active_generation_bytes", "new_generation_bytes", "publish_peak_bytes", "retained_bytes_after_publish", "reclaimable_bytes_after_publish"],
      "properties": {
        "existing_generation_bytes": { "$ref": "#/$defs/uint64" },
        "old_active_generation_bytes": { "$ref": "#/$defs/uint64" },
        "new_generation_bytes": { "$ref": "#/$defs/uint64" },
        "publish_peak_bytes": { "$ref": "#/$defs/uint64" },
        "retained_bytes_after_publish": { "$ref": "#/$defs/uint64" },
        "reclaimable_bytes_after_publish": { "$ref": "#/$defs/uint64" }
      }
    },
    "reindexEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forced_full_scan", "forced_full_analysis", "full_dependency_scan", "dependency_candidate_assets", "dependency_closure_assets", "analysis", "publish_warnings"],
      "properties": {
        "forced_full_scan": { "type": "boolean" },
        "forced_full_analysis": { "type": "boolean" },
        "full_dependency_scan": { "type": "boolean" },
        "dependency_candidate_assets": { "$ref": "#/$defs/uint64" },
        "dependency_closure_assets": { "$ref": "#/$defs/uint64" },
        "analysis": { "$ref": "#/$defs/reindexAnalysisEvidence" },
        "disk_estimate": { "$ref": "#/$defs/reindexDiskEstimate" },
        "publish_warnings": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reindexReceipt": { "type": "object", "additionalProperties": false, "required": ["protocol_revision", "disposition", "evidence"], "properties": { "protocol_revision": { "$ref": "#/$defs/revision" }, "disposition": { "enum": ["applied", "already_applied", "coalesced", "queued"] }, "transaction": { "$ref": "#/$defs/digest" }, "target_revision": { "$ref": "#/$defs/digest" }, "generation": { "$ref": "#/$defs/generationStamp" }, "evidence": { "$ref": "#/$defs/reindexEvidence" } } },
    "reindexStatus": { "type": "object", "additionalProperties": false, "required": ["operation_id", "state"], "properties": { "operation_id": { "$ref": "#/$defs/operationId" }, "state": { "enum": ["queued", "coalesced", "running", "succeeded", "failed", "cancelled", "expired", "lost"] }, "admission": { "$ref": "#/$defs/reindexReceipt" }, "completion": { "$ref": "#/$defs/reindexReceipt" }, "status": { "$ref": "#/$defs/statusResponse" }, "error": { "$ref": "#/$defs/apiError" } } },
    "apiError": { "type": "object", "additionalProperties": false, "required": ["protocol_revision", "code", "message", "retryable", "details"], "properties": { "protocol_revision": { "$ref": "#/$defs/revision" }, "code": { "enum": ["invalid_request", "invalid_cursor", "stale_cursor", "incompatible_protocol", "peer_rejected", "busy", "not_ready", "revision_mismatch", "index_build_failed", "idempotency_conflict", "operation_not_found", "operation_control_forbidden", "internal"] }, "message": { "type": "string" }, "retryable": { "type": "boolean" }, "generation": { "$ref": "#/$defs/generationStamp" }, "query_policy_id": { "$ref": "#/$defs/queryPolicyId" }, "details": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string" } } } },
    "responseOperation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "capabilities" }, "response": { "type": "object", "additionalProperties": false, "required": ["daemon_version", "capabilities"], "properties": { "daemon_version": { "type": "string", "minLength": 1 }, "capabilities": { "$ref": "#/$defs/capabilities" } } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "status" }, "response": { "$ref": "#/$defs/statusResponse" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "search" }, "response": { "$ref": "#/$defs/searchResponse" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "suggest" }, "response": { "$ref": "#/$defs/suggestResponse" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "references" }, "response": { "$ref": "#/$defs/referencesResponse" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "reindex_admit" }, "response": { "$ref": "#/$defs/reindexStatus" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "reindex_status" }, "response": { "$ref": "#/$defs/reindexStatus" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "reindex_wait" }, "response": { "$ref": "#/$defs/reindexStatus" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "reindex_cancel" }, "response": { "type": "object", "additionalProperties": false, "required": ["operation_id", "state", "cancelled"], "properties": { "operation_id": { "$ref": "#/$defs/operationId" }, "state": { "enum": ["queued", "coalesced", "running", "succeeded", "failed", "cancelled", "expired", "lost"] }, "cancelled": { "type": "boolean" } } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "response"], "properties": { "kind": { "const": "shutdown" }, "response": { "type": "object", "additionalProperties": false, "required": ["accepted"], "properties": { "accepted": { "type": "boolean" } } } } }
      ]
    },
    "responseEnvelope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_revision", "request_id", "project_id", "daemon_instance_id", "query_policy_id", "outcome", "value"],
          "properties": {
            "protocol_revision": { "$ref": "#/$defs/revision" },
            "request_id": { "$ref": "#/$defs/requestId" },
            "project_id": { "$ref": "#/$defs/projectId" },
            "daemon_instance_id": { "$ref": "#/$defs/daemonInstanceId" },
            "query_policy_id": { "$ref": "#/$defs/queryPolicyId" },
            "outcome": { "const": "success" },
            "value": { "$ref": "#/$defs/responseOperation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_revision", "request_id", "project_id", "daemon_instance_id", "query_policy_id", "outcome", "value"],
          "properties": {
            "protocol_revision": { "$ref": "#/$defs/revision" },
            "request_id": { "$ref": "#/$defs/requestId" },
            "project_id": { "$ref": "#/$defs/projectId" },
            "daemon_instance_id": { "$ref": "#/$defs/daemonInstanceId" },
            "query_policy_id": { "$ref": "#/$defs/queryPolicyId" },
            "outcome": { "const": "error" },
            "value": { "$ref": "#/$defs/apiError" }
          }
        }
      ]
    }
  }
}
