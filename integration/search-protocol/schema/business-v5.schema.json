    },
    "referenceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "location", "field_hints"],
      "properties": {
        "doc_file_id": { "$ref": "#/$defs/int64" },
        "doc_class_id": { "$ref": "#/$defs/int32" },
        "stable_id": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "object_name": { "type": "string" },
        "hierarchy_path": { "type": "string" },
        "field_hints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "referenceHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_kind", "stable_id", "source_object", "location", "contexts", "objects"],
      "properties": {
