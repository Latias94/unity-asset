        "truncated": { "type": "boolean" },
        "total": { "$ref": "#/$defs/uint64" },
        "serialized_bytes": { "$ref": "#/$defs/uint64" },
        "max_count": { "$ref": "#/$defs/uint32" },
        "max_serialized_bytes": { "$ref": "#/$defs/uint64" }
      }
    },
    "referenceContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doc_file_id": { "$ref": "#/$defs/int64" },
        "doc_class_id": { "$ref": "#/$defs/int32" },
        "object_name": { "type": "string" },
        "hierarchy_path": { "type": "string" },
        "field_hint": { "type": "string" },
        "source_line": { "$ref": "#/$defs/uint32" },
        "source_column": { "$ref": "#/$defs/uint32" }
