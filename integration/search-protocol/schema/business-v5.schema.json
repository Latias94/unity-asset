    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "severity", "code", "message", "address", "field_path"],
      "properties": {
        "version": { "const": 2 },
        "severity": { "enum": ["error", "warning", "info"] },
        "code": { "type": "string", "minLength": 1, "pattern": "^[A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1 },
        "address": {
          "oneOf": [
            { "$ref": "#/$defs/objectAddress" },
            { "type": "null" }
          ]
        },
        "field_path": {
          "oneOf": [
            { "$ref": "#/$defs/fieldPath" },
            { "type": "null" }
          ]
        }
      }
    },
    "referencesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_revision", "generation", "query_policy_id", "request", "took_ms", "coverage", "hits", "diagnostics", "diagnostic_coverage"],
