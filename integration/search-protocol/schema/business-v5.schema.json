        "source_kind": { "type": "string" },
        "stable_id": { "type": "string" },
        "source_object": { "$ref": "#/$defs/objectAddress" },
        "location": { "$ref": "#/$defs/location" },
        "contexts": { "type": "array", "items": { "$ref": "#/$defs/referenceContext" } },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/referenceObject" } }
      }
    },
    "fieldPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
