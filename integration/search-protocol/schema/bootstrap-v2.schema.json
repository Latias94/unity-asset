{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unity-asset:search-protocol:bootstrap:2",
  "title": "Unity Asset Search Bootstrap V2",
  "description": "Structural JSON shape for Bootstrap V2. Rust and C# conformance remain authoritative for canonical encoding, negotiation, and cross-message binding.",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/accepted"
    },
    {
      "$ref": "#/$defs/rejected"
    }
  ],
  "$defs": {
    "bootstrapVersion": {
      "type": "integer",
      "const": 2
    },
    "businessRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "projectId": {
      "type": "string",
      "pattern": "^project-v1:[0-9a-f]{64}$"
    },
    "daemonInstanceId": {
      "type": "string",
      "pattern": "^daemon-v1:[0-9a-f]{32}$"
    },
    "queryPolicyId": {
      "type": "string",
      "pattern": "^query-policy-v1:[0-9a-f]{64}$"
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_version",
        "project_id",
        "daemon_instance_id",
        "supported_revisions"
      ],
      "properties": {
        "bootstrap_version": {
          "$ref": "#/$defs/bootstrapVersion"
        },
        "project_id": {
          "$ref": "#/$defs/projectId"
        },
        "daemon_instance_id": {
          "$ref": "#/$defs/daemonInstanceId"
        },
        "supported_revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/businessRevision"
          }
        }
      }
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "bootstrap_version",
        "project_id",
        "daemon_instance_id",
        "query_policy_id",
        "selected_revision"
      ],
      "properties": {
        "result": {
          "const": "accepted"
        },
        "bootstrap_version": {
          "$ref": "#/$defs/bootstrapVersion"
        },
        "project_id": {
          "$ref": "#/$defs/projectId"
        },
        "daemon_instance_id": {
          "$ref": "#/$defs/daemonInstanceId"
        },
        "query_policy_id": {
          "$ref": "#/$defs/queryPolicyId"
        },
        "selected_revision": {
          "$ref": "#/$defs/businessRevision"
        }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "bootstrap_version",
        "code"
      ],
      "properties": {
        "result": {
          "const": "rejected"
        },
        "bootstrap_version": {
          "$ref": "#/$defs/bootstrapVersion"
        },
        "code": {
          "enum": [
            "project_mismatch",
            "instance_mismatch",
            "no_common_revision"
          ]
        }
      }
    }
  }
}
